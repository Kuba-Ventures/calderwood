# Anthropic — required for PDF parsing (Phase 4)
ANTHROPIC_API_KEY=

# Admin gates
ADMIN_PASSWORD=
DEMO_FINLEY_PASSWORD=

# Stripe — required to unlock the gated report. Use sandbox/test keys locally.
# STRIPE_WEBHOOK_SECRET comes from `stripe listen` (local) or the dashboard
# endpoint for /api/stripe/webhook (deployed).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional: absolute site URL for Stripe Checkout success/cancel redirects.
# Falls back to the request host when unset.
NEXT_PUBLIC_SITE_URL=

# Supabase — required for backend persistence
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (Supabase dashboard: Settings → Database → URI)
# Only needed for `npm run db:migrate`. Keep server-side; never expose.
SUPABASE_DB_URL=

# Resend — required for delivery emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TEAM_NOTIFICATION_EMAIL=

# Resend inbound: mail to sales@newfeeschedule.com is forwarded by /api/inbound.
# RESEND_API_KEY (above) needs send access for newfeeschedule.com plus access
# to received emails. RESEND_WEBHOOK_SECRET is the signing secret (whsec_...)
# of the Resend webhook for email.received.
RESEND_WEBHOOK_SECRET=
# Comma-separated. Defaults to finley@qsbsrollover.com,calderwoodra1113@gmail.com
INBOUND_FORWARD_TO=
# Defaults to "New Fee Schedule <forwarding@newfeeschedule.com>"
INBOUND_FORWARD_FROM=

# PostHog — optional, required before paid traffic
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Tag Manager — container id (GTM-XXXXXXX). GA4 is configured inside the
# GTM container, so the app only needs this one id. Unset = analytics disabled.
NEXT_PUBLIC_GTM_ID=
