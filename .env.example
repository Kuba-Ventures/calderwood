# Anthropic — required for PDF parsing (Phase 4)
ANTHROPIC_API_KEY=

# Admin gates
ADMIN_PASSWORD=
DEMO_FINLEY_PASSWORD=

# Stripe — required for Phase 3 payment gate
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Supabase — required for backend persistence
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (Supabase dashboard: Settings → Database → URI)
# Only needed for `npm run db:migrate`. Keep server-side; never expose.
SUPABASE_DB_URL=

# Resend — required for delivery emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TEAM_NOTIFICATION_EMAIL=

# PostHog — optional, required before paid traffic
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
